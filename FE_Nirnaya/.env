# FE_Nirnaya/.env
# ─────────────────────────────────────────────────────────
# Vite reads VITE_* variables at build time and embeds them
# into the bundle — do NOT put secrets here.
# ─────────────────────────────────────────────────────────

# Backend REST base URL (no trailing slash)
VITE_API_BASE_URL=https://nirnaya-data-analytics-agent.onrender.com/api/v1

# Backend WebSocket base URL (no path)
VITE_WS_BASE_URL=wss://nirnaya-data-analytics-agent.onrender.com
